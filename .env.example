DATABASE_URL=
# random, 32+ chars: openssl rand -base64 32
AUTH_SECRET=
# the one shared sign-in password (changing it signs everyone out)
APP_PASSWORD=
TELEGRAM_BOT_TOKEN=

# ---- Whereabouts (bot + Mini App). Everything below is optional: with the
# ---- FEATURE_* flags unset the app is exactly the v1 parade-state app.
# "1" turns on the bot webhook, the Mini App (/tg) and /api/wb/*. Anything else = off (404).
FEATURE_WHEREABOUTS=
# "1" lets the timeline write v1 absences/duties (Phase 6). Leave off.
FEATURE_PROJECTION=
# "1" turns on transport claims (Phase 7). Leave off.
FEATURE_CLAIMS=
# The whereabouts bot's own token from @BotFather. Never the parade-state bot's TELEGRAM_BOT_TOKEN.
WB_BOT_TOKEN=
# random, 32+ chars (openssl rand -hex 32): Telegram sends it with every webhook call; also authorises npm run wb:setup
WB_WEBHOOK_SECRET=
# comma-separated Telegram user ids that are always Sabre admins (get yours with /whoami)
WB_ADMIN_TELEGRAM_IDS=
# public https base URL of this deployment (or your tunnel to next dev), e.g. https://sabre.vercel.app
WB_APP_URL=
# random, 32+ chars (openssl rand -hex 32): Vercel sends it to the evening-round cron (/api/wb/cron/evening, 1900 SGT daily)
CRON_SECRET=
